[Unit]
Description=Pi Agent Buddy sidecar
Documentation=https://github.com/foxleoly/pi-agent-buddy
After=network-online.target

[Service]
Type=simple
# The sidecar follows the most recently updated pi session; add --pi-pid <pid> to
# pin one process when several agents are running.
ExecStart=%h/.local/bin/pi-buddy-sidecar --ws --ws-addr :51820
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
