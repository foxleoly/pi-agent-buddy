[Unit]
Description=Pi Agent Buddy sidecar
Documentation=https://github.com/foxleoly/pi-agent-buddy
After=network-online.target

[Service]
Type=simple
# @PANE@ is the herdr pane the device's buttons control (for example w4:p1).
# It is required: without --target an act goes to the focused pane, which may be
# the very session running the sidecar.
ExecStart=%h/.local/bin/pi-buddy-sidecar --ws --ws-addr :51820 --target @PANE@
Restart=always
RestartSec=2
# The sidecar shells out to herdr, and a user unit gets a minimal PATH; add the
# directories herdr may live in.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
