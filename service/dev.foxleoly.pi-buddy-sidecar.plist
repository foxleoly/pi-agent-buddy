<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd does not expand ~ or environment variables, so @HOME@ is substituted
  before installing (see the README). The sidecar follows the most recently
  updated pi session; add --pi-pid <pid> to pin one process.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.foxleoly.pi-buddy-sidecar</string>

  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/pi-buddy-sidecar</string>
    <string>--ws</string>
    <string>--ws-addr</string>
    <string>:51820</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>@HOME@/.pi-buddy/sidecar.out.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.pi-buddy/sidecar.err.log</string>
</dict>
</plist>
